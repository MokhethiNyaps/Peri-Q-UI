# Add the full public URL for each account, then redeploy on Vercel.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Use the same production Supabase project and publishable key as the app.
# Never use a service-role or secret key in a NEXT_PUBLIC variable.
# In Vercel, enter only each value (without the variable name or quotation marks).
# URL example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site URL (used for Yoco success/cancel/failure redirects and SEO)
# Example: https://rastasperiq.co.za
NEXT_PUBLIC_SITE_URL=https://rastasperiq.co.za

# --- Server-only secrets: Vercel Project Settings → Environment Variables (Production) ---
# Never put these in NEXT_PUBLIC_* or commit them to Git.

# Supabase project URL and service-role key (for server verification/webhooks)
# Find in Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Yoco Checkout API — Test keys work immediately; Live keys require verified domain
# Find in Yoco App → Sales → Payment Gateway → How to connect → Test keys / Live keys
YOCO_SECRET_KEY=sk_test_...
YOCO_WEBHOOK_SECRET=whsec_...

# Optional fallback if NEXT_PUBLIC_SITE_URL is not set on server
SITE_URL=https://rastasperiq.co.za

# Socials (already supported)
# NEXT_PUBLIC_INSTAGRAM_URL already above
# Switching to live Yoco keys: see GO_LIVE_CLIENT_CHECKLIST.md
