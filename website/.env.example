# Add the full public URL for each account, then redeploy on Vercel.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Use the same production Supabase project and publishable key as the app.
# Never use a service-role or secret key in a NEXT_PUBLIC variable.
# In Vercel, enter only each value (without the variable name or quotation marks).
# URL example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
